# ============================================================
#  Tawi Study — environment variables
#  Copy this file to `.env` (local) or paste these into
#  Vercel → Project → Settings → Environment Variables.
# ============================================================

# ---------- 1. DATABASE (required) --------------------------
# Free unlimited-ish Postgres. Pick ONE, paste the URL below.
#
#   Neon      https://neon.tech          (recommended — free forever, no card)
#   Supabase  https://supabase.com       (free, use the "Connection pooling" URL)
#   Vercel    Storage tab → Postgres     (auto-injects POSTGRES_URL, nothing to do)
#
# Neon gives you a string that looks exactly like this:
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Local Postgres instead? Use this shape (SSL is auto-disabled for localhost):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/studyapp

# Tables are created automatically on first request — no migration command needed.


# ---------- 2. SESSION SECRET (recommended) -----------------
# Any long random string. Generate one: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string


# ---------- 3. AI (optional — app works fully without it) ----
# Leave every key blank and the built-in offline engine handles
# summaries, flashcards and questions. Add ONE free key below for
# LLM-grade rewritten/formatted text. First match wins.

# Google Gemini — best free tier, no card required.
#   Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq — free, extremely fast Llama models.
#   Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — free models (append :free to the model name).
#   Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI — paid.
#   Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
